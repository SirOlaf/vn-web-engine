diff --git a/src/engines/buriko/native/bitmap-gpu.ts b/src/engines/buriko/native/bitmap-gpu.ts
new file mode 100644
index 0000000..7687d4a
--- /dev/null
+++ b/src/engines/buriko/native/bitmap-gpu.ts
@@ -0,0 +1,536 @@
+import {
+  flushPixelBatch,
+  withPixelBatch,
+  type SynchronousPixelBatch,
+} from '../../../graphics/pixel-batch.js';
+import {
+  WebGLIntegerCompositor,
+  type WebGLIntegerCommand,
+  type WebGLIntegerPlane,
+} from '../../../graphics/webgl-integer-compositor.js';
+import {beginRuntimeSpan, recordRuntimeMetric} from '../../../platform/runtime-performance.js';
+import {reportRuntimeAdvisory} from '../../../platform/runtime-advisories.js';
+import {
+  isBatchableBurikoBitmapStorage,
+  type BurikoBitmap,
+  type BurikoBitmapStorage,
+} from './bitmap.js';
+import type {BurikoBitmapAffineCoordinates} from './bitmap-affine.js';
+
+interface Parameters {
+  kind: 0 | 1 | 2 | 3; // Clear, row copy, affine alpha, ordinary alpha.
+  sourceX: number;
+  sourceY: number;
+  width: number;
+  height: number;
+  transparency: number; // -1 selects ordinary alpha's pair/tail rules.
+  bilinear: boolean;
+  coordinates: BurikoBitmapAffineCoordinates;
+}
+const ZERO_COORDINATES: BurikoBitmapAffineCoordinates = {
+  startX: 0,
+  startY: 0,
+  columnX: 0,
+  columnY: 0,
+  rowX: 0,
+  rowY: 0,
+};
+
+/** Native byte channels are independent; no normalized colors or hardware blending. */
+const FRAGMENT = `#version 300 es
+precision highp float;
+precision highp int;
+precision highp usampler2D;
+uniform usampler2D sourcePixels;
+uniform usampler2D oldDestination;
+uniform int kind;
+uniform ivec2 origin;
+uniform ivec2 sourceOrigin;
+uniform ivec2 sourceSize;
+uniform uvec2 start;
+uniform uvec2 columnStep;
+uniform uvec2 rowStep;
+uniform int transparency;
+uniform int bilinear;
+layout(location=0) out uvec4 result;
+uvec4 sourceAt(ivec2 p) {
+  if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, sourceSize))) return uvec4(0);
+  return texelFetch(sourcePixels, sourceOrigin + p, 0);
+}
+uvec4 lerp4(uvec4 a, uvec4 b, uint fraction) {
+  return (a * (16u - fraction) + b * fraction) >> 4u;
+}
+void main() {
+  ivec2 position = ivec2(gl_FragCoord.xy), local = position - origin;
+  if (kind == 0) { result = uvec4(0); return; }
+  uvec4 source;
+  if (kind == 2) {
+    uvec2 fixedPosition = start + uint(local.x) * columnStep + uint(local.y) * rowStep;
+    if (bilinear == 0) source = sourceAt(ivec2(fixedPosition + uvec2(32768u)) >> 16);
+    else {
+      ivec2 p = ivec2(fixedPosition) >> 16;
+      uvec2 fraction = (fixedPosition >> 12u) & 15u;
+      source = lerp4(lerp4(sourceAt(p), sourceAt(p + ivec2(1, 0)), fraction.x),
+        lerp4(sourceAt(p + ivec2(0, 1)), sourceAt(p + ivec2(1, 1)), fraction.x), fraction.y);
+    }
+  } else source = sourceAt(local);
+  if (kind == 1) { result = source; return; }
+  uvec4 old = texelFetch(oldDestination, position, 0);
+  uint index = source.a >> 1u;
+  uint coefficient;
+  if (kind == 2) coefficient = ((index == 127u ? 128u : index) * uint(256 - transparency)) >> 8u;
+  else if (transparency >= 0) coefficient = (index * uint(256 - transparency)) >> 8u;
+  else {
+    bool tail = local.x == sourceSize.x - 1 && (sourceSize.x & 1) != 0;
+    if (tail && source.a >= 254u) { result = uvec4(source.rgb, 0u); return; }
+    if (!tail && source.a >= 254u && sourceAt(ivec2(local.x ^ 1, local.y)).a >= 254u) {
+      result = source; return;
+    }
+    coefficient = !tail && index == 127u ? 128u : index;
+  }
+  result = uvec4((source.rgb * coefficient + old.rgb * (128u - coefficient)) >> 7u, old.a);
+}`;
+
+function createCompositor(): WebGLIntegerCompositor<Parameters> {
+  return new WebGLIntegerCompositor({
+    fragmentSource: FRAGMENT,
+    // Every oldDestination fetch uses this output pixel; sources are immutable.
+    independentPixels: true,
+    bindUniforms(gl, program) {
+      // Values persist with this private program. Independent strips commonly
+      // change only their origin and Q16 start, so avoid redundant driver calls.
+      const scalar = (name: string) => {
+        const location = gl.getUniformLocation(program, name);
+        let previous = NaN;
+        return (value: number) => {
+          if (value === previous) return;
+          gl.uniform1i(location, value);
+          previous = value;
+        };
+      };
+      const pair = (name: string, unsigned = false) => {
+        const location = gl.getUniformLocation(program, name);
+        let previousX = NaN,
+          previousY = NaN;
+        return (x: number, y: number) => {
+          if (x === previousX && y === previousY) return;
+          if (unsigned) gl.uniform2ui(location, x, y);
+          else gl.uniform2i(location, x, y);
+          previousX = x;
+          previousY = y;
+        };
+      };
+      const kind = scalar('kind'),
+        origin = pair('origin'),
+        sourceOrigin = pair('sourceOrigin'),
+        size = pair('sourceSize'),
+        start = pair('start', true),
+        column = pair('columnStep', true),
+        row = pair('rowStep', true),
+        transparency = scalar('transparency'),
+        bilinear = scalar('bilinear');
+      return (p, command) => {
+        kind(p.kind);
+        if (p.kind === 0) return;
+        origin(command.rectangle.x, command.rectangle.y);
+        sourceOrigin(p.sourceX, p.sourceY);
+        size(p.width, p.height);
+        if (p.kind === 1) return;
+        transparency(p.transparency);
+        if (p.kind !== 2) return;
+        start(p.coordinates.startX >>> 0, p.coordinates.startY >>> 0);
+        column(p.coordinates.columnX >>> 0, p.coordinates.columnY >>> 0);
+        row(p.coordinates.rowX >>> 0, p.coordinates.rowY >>> 0);
+        bilinear(Number(p.bilinear));
+      };
+    },
+  });
+}
+
+interface Target {
+  storage: BurikoBitmapStorage;
+  plane: WebGLIntegerPlane;
+  commands: WebGLIntegerCommand<Parameters>[];
+  replay: (() => void)[];
+  pixels: number;
+}
+interface Input {
+  storage: BurikoBitmapStorage;
+  stride: number;
+  plane: WebGLIntegerPlane;
+}
+let active: BurikoGpuBitmapBatch | null = null;
+
+/** Keep software rendering free of deferred-command closures and descriptor snapshots. */
+export function hasBurikoGpuBatch(): boolean {
+  return active?.acceptsCommands ?? false;
+}
+
+/** Foreign callbacks may retain raw views or replace methods audited at traversal entry. */
+export function withBurikoGpuSuspended<T>(operation: () => T): T {
+  flushPixelBatch();
+  const previous = active;
+  previous?.invalidate();
+  active = null;
+  try {
+    return operation();
+  } finally {
+    active = previous;
+  }
+}
+
+/** Only an audited synchronous display traversal installs this scope. */
+export class BurikoGpuBitmapBatch implements SynchronousPixelBatch {
+  private readonly gpu = createCompositor();
+  private root: BurikoBitmap | null = null;
+  private targets: Target[] = [];
+  private inputs: Input[] = [];
+  private watched = new Set<ArrayBufferLike>();
+  private commandCount = 0;
+  private auditValid = false;
+  private storageAudit = new Set<object>();
+
+  get storageAuditCache(): Set<object> {
+    return this.storageAudit;
+  }
+
+  get acceptsCommands(): boolean {
+    return this.auditValid;
+  }
+
+  /** An unknown callback invalidates admission for the rest of this traversal. */
+  invalidate(): void {
+    this.auditValid = false;
+  }
+
+  /** Numerical probes can force small batches through the same production path. */
+  constructor(
+    private readonly minimumPixels = 16384,
+    private readonly minimumCommands = 8,
+  ) {}
+
+  run<T>(root: BurikoBitmap, operation: () => T): T {
+    if (this.gpu.failed || root.format !== 1) return operation();
+    return withPixelBatch(this, () => {
+      const previous = active,
+        previousRoot = this.root,
+        previousAudit = this.auditValid,
+        previousStorageAudit = this.storageAudit;
+      this.root = {...root};
+      this.auditValid = true;
+      this.storageAudit = new Set();
+      active = this;
+      recordRuntimeMetric('buriko.gpu.frames', 1);
+      try {
+        return operation();
+      } finally {
+        try {
+          flushPixelBatch();
+        } finally {
+          active = previous;
+          this.root = previousRoot;
+          this.auditValid = previousAudit;
+          this.storageAudit = previousStorageAudit;
+        }
+      }
+    });
+  }
+
+  hasPending(storage: object): boolean {
+    if (this.commandCount === 0) return false;
+    if (!isBatchableBurikoBitmapStorage(storage, this.storageAudit)) {
+      this.invalidate();
+      return true;
+    }
+    const view = storage.batchingView(0, 0);
+    return view !== null && this.watched.has(view.buffer);
+  }
+
+  /** Per-target streams are independent: dependencies and aliases flush before admission. */
+  flush(): void {
+    if (this.commandCount === 0) {
+      this.targets = [];
+      this.inputs = [];
+      this.watched.clear();
+      return;
+    }
+    const previous = active;
+    active = null;
+    const targets = this.targets,
+      inputs = this.inputs;
+    this.targets = [];
+    this.inputs = [];
+    this.watched.clear();
+    this.commandCount = 0;
+    const finish = beginRuntimeSpan('buriko.gpu.flush');
+    try {
+      for (const target of targets) {
+        // Avoid GPU roundtrips for fragments interrupted by an unsupported CPU operation.
+        const useGpu =
+          target.commands.length >= this.minimumCommands && target.pixels >= this.minimumPixels;
+        const completed =
+          useGpu &&
+          this.gpu.run(
+            target.plane,
+            inputs.map((i) => i.plane),
+            target.commands,
+          );
+        if (completed) {
+          recordRuntimeMetric('buriko.gpu.commands', target.commands.length);
+          recordRuntimeMetric('buriko.gpu.pixels', target.pixels);
+          recordRuntimeMetric('buriko.gpu.readbacks', 1);
+        } else {
+          for (const replay of target.replay) replay();
+          recordRuntimeMetric('buriko.gpu.software-commands', target.commands.length);
+        }
+      }
+      if (this.gpu.failed)
+        reportRuntimeAdvisory({
+          id: 'webgl-composition-fallback',
+          title: 'Software graphics fallback',
+          message:
+            'The experimental WebGL 2 backend is unavailable or its context was lost. Rendering continues in software. Restart the game to retry WebGL 2.',
+        });
+    } finally {
+      finish?.();
+      active = previous;
+    }
+  }
+
+  queue(
+    destination: BurikoBitmap,
+    source: BurikoBitmap | null,
+    parameters: Parameters,
+    replay: (d: BurikoBitmap, s: BurikoBitmap | null) => void,
+  ): boolean {
+    const root = this.root;
+    if (
+      !this.auditValid ||
+      !root ||
+      this.gpu.failed ||
+      destination.format !== 1 ||
+      destination.bytesPerPixel !== 4 ||
+      destination.stride !== root.stride ||
+      !root.storage
+    )
+      return this.decline();
+    const output = initializedPlane(destination);
+    const input = source === null ? null : initializedPlane(source);
+    if (
+      !output ||
+      (source !== null && !input) ||
+      (input && input.bytes.buffer === output.bytes.buffer)
+    )
+      return this.decline();
+    const delta = destination.offset - root.offset;
+    const y = Math.floor(delta / root.stride),
+      x = (delta - y * root.stride) / 4;
+    if (
+      !Number.isSafeInteger(x) ||
+      x < 0 ||
+      y < 0 ||
+      x + destination.width > root.width ||
+      y + destination.height > root.height
+    )
+      return this.decline();
+    const storage = destination.storage!;
+    const full = initializedPlane({...root, storage});
+    if (!full) return this.decline();
+    // All queued inputs remain immutable, and every target is a distinct buffer.
+    if (
+      this.inputs.some((i) => i.plane.bytes.buffer === full.bytes.buffer) ||
+      this.targets.some(
+        (t) => t.storage !== storage && t.plane.bytes.buffer === full.bytes.buffer,
+      ) ||
+      (input && this.targets.some((t) => t.plane.bytes.buffer === input.bytes.buffer)) ||
+      this.commandCount >= 4096
+    )
+      flushPixelBatch();
+    let target = this.targets.find((t) => t.storage === storage);
+    if (!target) {
+      if (this.targets.length >= 4) flushPixelBatch();
+      target = {storage, plane: full, commands: [], replay: [], pixels: 0};
+      this.targets.push(target);
+    }
+    let sourceIndex: number | null = null;
+    if (source && input) {
+      sourceIndex = this.inputs.findIndex(
+        (i) => i.storage === source.storage && i.stride === source.stride,
+      );
+      if (sourceIndex < 0) {
+        // One upload per backing row layout, preserving the crop as integer uniforms.
+        const width = source.stride / 4,
+          height = Math.floor(source.storage!.byteLength / source.stride);
+        if (
+          width > 8192 ||
+          height > 8192 ||
+          height < 1 ||
+          Math.floor(source.offset / source.stride) + source.height > height ||
+          this.inputs.length >= 32
+        )
+          return this.decline();
+        sourceIndex = this.inputs.length;
+        this.inputs.push({
+          storage: source.storage!,
+          stride: source.stride,
+          plane: {...input, offset: 0, width, height},
+        });
+      }
+      parameters.sourceY = Math.floor(source.offset / source.stride);
+      parameters.sourceX = (source.offset - parameters.sourceY * source.stride) / 4;
+      this.watched.add(input.bytes.buffer);
+    }
+    target.commands.push({
+      source: sourceIndex,
+      rectangle: {x, y, width: destination.width, height: destination.height},
+      parameters,
+    });
+    const d = {...destination},
+      s = source && {...source};
+    target.replay.push(() => replay(d, s));
+    target.pixels += destination.width * destination.height;
+    this.watched.add(full.bytes.buffer);
+    this.commandCount++;
+    return true;
+  }
+
+  private decline(): false {
+    flushPixelBatch();
+    return false;
+  }
+  dispose(): void {
+    this.flush();
+    this.gpu.dispose();
+  }
+}
+
+/** Deliberately declines holes, shared memory, unusual pitches and invalid descriptors. */
+function initializedPlane(bitmap: BurikoBitmap): WebGLIntegerPlane | null {
+  const {storage, width, height, stride, offset} = bitmap;
+  if (!isBatchableBurikoBitmapStorage(storage, active?.storageAuditCache)) {
+    // The ensuing software path can invoke arbitrary storage overrides. Do not
+    // reuse the traversal audit after that callback, even for other allocations.
+    active?.invalidate();
+    return null;
+  }
+  if (
+    bitmap.bytesPerPixel !== 4 ||
+    !Number.isSafeInteger(width) ||
+    width < 1 ||
+    width > 8192 ||
+    !Number.isSafeInteger(height) ||
+    height < 1 ||
+    height > 8192 ||
+    !Number.isSafeInteger(stride) ||
+    stride < width * 4 ||
+    stride > 32767 * 4 ||
+    (stride & 3) !== 0 ||
+    !Number.isSafeInteger(offset) ||
+    offset < 0 ||
+    (offset & 3) !== 0 ||
+    (offset % stride) + width * 4 > stride
+  )
+    return null;
+  const view = storage.batchingView(offset, (height - 1) * stride + width * 4);
+  if (!view || !(view.buffer instanceof ArrayBuffer)) return null;
+  return {
+    bytes: new Uint8Array(view.buffer, view.byteOffset, view.byteLength),
+    offset,
+    stride,
+    width,
+    height,
+  };
+}
+
+function parameters(
+  kind: Parameters['kind'],
+  source: BurikoBitmap | null,
+  transparency = 0,
+): Parameters {
+  return {
+    kind,
+    sourceX: 0,
+    sourceY: 0,
+    width: source?.width ?? 0,
+    height: source?.height ?? 0,
+    transparency,
+    bilinear: false,
+    coordinates: ZERO_COORDINATES,
+  };
+}
+export function tryQueueBurikoClear(
+  destination: BurikoBitmap,
+  replay: (d: BurikoBitmap) => void,
+): boolean {
+  return active?.queue(destination, null, parameters(0, null), (d) => replay(d)) ?? false;
+}
+export function tryQueueBurikoCopy(
+  destination: BurikoBitmap,
+  source: BurikoBitmap,
+  replay: (d: BurikoBitmap, s: BurikoBitmap) => void,
+): boolean {
+  if (!active) return false;
+  if (
+    source.format !== 1 ||
+    source.width > destination.width ||
+    source.height > destination.height
+  ) {
+    flushPixelBatch();
+    return false;
+  }
+  return active.queue(
+    {...destination, width: source.width, height: source.height},
+    source,
+    parameters(1, source),
+    (d, s) => replay(d, s!),
+  );
+}
+export function tryQueueBurikoAlpha(
+  destination: BurikoBitmap,
+  source: BurikoBitmap,
+  transparency: number | null,
+  replay: (d: BurikoBitmap, s: BurikoBitmap) => void,
+): boolean {
+  if (!active) return false;
+  if (
+    source.format !== 2 ||
+    source.width > destination.width ||
+    source.height > destination.height ||
+    (transparency !== null &&
+      (!Number.isInteger(transparency) || transparency < 0 || transparency > 255))
+  ) {
+    flushPixelBatch();
+    return false;
+  }
+  return active.queue(
+    {...destination, width: source.width, height: source.height},
+    source,
+    parameters(3, source, transparency ?? -1),
+    (d, s) => replay(d, s!),
+  );
+}
+export function tryQueueBurikoAffine(
+  destination: BurikoBitmap,
+  source: BurikoBitmap,
+  coordinates: BurikoBitmapAffineCoordinates,
+  transparency: number,
+  bilinear: boolean,
+  replay: (d: BurikoBitmap, s: BurikoBitmap) => void,
+): boolean {
+  if (!active) return false;
+  if (
+    source.format !== 2 ||
+    !Number.isInteger(transparency) ||
+    transparency < 0 ||
+    transparency > 255
+  ) {
+    flushPixelBatch();
+    return false;
+  }
+  return active.queue(
+    destination,
+    source,
+    {...parameters(2, source, transparency), coordinates: {...coordinates}, bilinear},
+    (d, s) => replay(d, s!),
+  );
+}
diff --git a/src/graphics/graphics-backend.ts b/src/graphics/graphics-backend.ts
new file mode 100644
index 0000000..18c39e0
--- /dev/null
+++ b/src/graphics/graphics-backend.ts
@@ -0,0 +1,31 @@
+/** Browser graphics backend preference. CPU rendering remains the compatibility default. */
+export type GraphicsBackend = 'software' | 'webgl2';
+
+const STORAGE_KEY = 'vn.graphics-backend';
+
+function preferenceStorage(): Storage | null {
+  try {
+    return globalThis.localStorage;
+  } catch {
+    return null;
+  }
+}
+
+/** Read the persisted backend preference, falling back safely when storage is unavailable. */
+export function getGraphicsBackendPreference(): GraphicsBackend {
+  try {
+    return preferenceStorage()?.getItem(STORAGE_KEY) === 'webgl2' ? 'webgl2' : 'software';
+  } catch {
+    return 'software';
+  }
+}
+
+/** Persist a backend preference when browser storage is available. */
+export function setGraphicsBackendPreference(backend: GraphicsBackend): void {
+  if (backend !== 'software' && backend !== 'webgl2') return;
+  try {
+    preferenceStorage()?.setItem(STORAGE_KEY, backend);
+  } catch {
+    /* A preference remains optional when browser storage is disabled. */
+  }
+}
diff --git a/src/graphics/pixel-batch.ts b/src/graphics/pixel-batch.ts
new file mode 100644
index 0000000..3061df7
--- /dev/null
+++ b/src/graphics/pixel-batch.ts
@@ -0,0 +1,40 @@
+/** Optional synchronous pixel work. Native storage must be current at observation boundaries. */
+export interface SynchronousPixelBatch {
+  hasPending(storage: object): boolean;
+  flush(): void;
+}
+
