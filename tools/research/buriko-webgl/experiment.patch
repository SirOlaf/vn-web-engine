+
+  /** Independently verifies integer upload, arithmetic, partial draws, blit, and readback. */
+  private healthCheck(): void {
+    const gl = this.gl!,
+      textures: IntegerTexture[] = [],
+      framebuffers: WebGLFramebuffer[] = [];
+    let program: WebGLProgram | null = null;
+    try {
+      program = this.createProgram(`#version 300 es
+precision highp int;
+precision highp usampler2D;
+uniform usampler2D sourcePixels;
+uniform usampler2D oldDestination;
+layout(location=0) out uvec4 result;
+void main() {
+  ivec2 p = ivec2(gl_FragCoord.xy);
+  uvec4 a = texelFetch(sourcePixels, p, 0), b = texelFetch(oldDestination, p, 0);
+  result = ((a * 3u + b * 5u + uvec4(0u, 1u, 127u, 255u)) & 255u) ^ uvec4(128u, 0u, 255u, 1u);
+}`);
+      const source = new Uint8Array([
+        0, 1, 127, 128, 254, 255, 2, 3, 23, 45, 67, 89, 255, 128, 1, 0,
+      ]);
+      const original = new Uint8Array([
+        255, 254, 129, 128, 0, 1, 2, 3, 250, 120, 30, 10, 13, 17, 19, 23,
+      ]);
+      for (let index = 0; index < 3; index++) textures.push(this.createTexture(2, 2));
+      this.upload(textures[0]!, source);
+      this.upload(textures[1]!, original);
+      this.upload(textures[2]!, original);
+      for (let index = 0; index < 2; index++) {
+        const framebuffer = gl.createFramebuffer();
+        if (framebuffer === null) throw new Error('Cannot allocate integer health framebuffer');
+        framebuffers.push(framebuffer);
+        this.attach(framebuffer, textures[index + 1]!);
+      }
+      gl.useProgram(program);
+      gl.uniform1i(gl.getUniformLocation(program, 'sourcePixels'), 0);
+      gl.uniform1i(gl.getUniformLocation(program, 'oldDestination'), 1);
+      gl.viewport(0, 0, 2, 2);
+      this.bindTexture(0, textures[0]!);
+      const expected = original.slice(),
+        rectangles = [
+          {x: 0, y: 0, width: 1, height: 2},
+          {x: 0, y: 1, width: 2, height: 1},
+        ];
+      let input = 0,
+        output = 1;
+      for (const [index, rectangle] of rectangles.entries()) {
+        if (index !== 0) {
+          gl.disable(gl.SCISSOR_TEST);
+          gl.bindFramebuffer(gl.READ_FRAMEBUFFER, framebuffers[input]!);
+          gl.bindFramebuffer(gl.DRAW_FRAMEBUFFER, framebuffers[output]!);
+          gl.blitFramebuffer(0, 0, 1, 2, 0, 0, 1, 2, gl.COLOR_BUFFER_BIT, gl.NEAREST);
+        }
+        gl.bindFramebuffer(gl.FRAMEBUFFER, framebuffers[output]!);
+        this.bindTexture(1, textures[input + 1]!);
+        gl.enable(gl.SCISSOR_TEST);
+        gl.scissor(rectangle.x, rectangle.y, rectangle.width, rectangle.height);
+        gl.drawArrays(gl.TRIANGLES, 0, 3);
+        for (let y = rectangle.y; y < rectangle.y + rectangle.height; y++)
+          for (let x = rectangle.x; x < rectangle.x + rectangle.width; x++)
+            for (let channel = 0; channel < 4; channel++) {
+              const offset = (y * 2 + x) * 4 + channel;
+              expected[offset] =
+                ((source[offset]! * 3 + expected[offset]! * 5 + [0, 1, 127, 255][channel]!) & 255) ^
+                [128, 0, 255, 1][channel]!;
+            }
+        [input, output] = [output, input];
+      }
+      const actual = new Uint8Array(16);
+      gl.readPixels(0, 0, 2, 2, gl.RGBA_INTEGER, gl.UNSIGNED_BYTE, actual);
+      if (
+        gl.isContextLost() ||
+        gl.getError() !== gl.NO_ERROR ||
+        actual.some((value, index) => value !== expected[index])
+      )
+        throw new Error('Integer graphics health check failed');
+    } finally {
+      for (const framebuffer of framebuffers) gl.deleteFramebuffer(framebuffer);
+      for (const texture of textures) gl.deleteTexture(texture.handle);
+      gl.deleteProgram(program);
+      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
+    }
+  }
+
+  private release(): void {
+    const gl = this.gl;
+    if (gl !== null) {
+      for (const texture of this.destinations ?? []) gl.deleteTexture(texture.handle);
+      for (const texture of this.sources) if (texture) gl.deleteTexture(texture.handle);
+      for (const framebuffer of this.framebuffers ?? []) gl.deleteFramebuffer(framebuffer);
+      gl.deleteTexture(this.zero?.handle ?? null);
+      gl.deleteProgram(this.program);
+      gl.deleteVertexArray(this.vertexArray);
+      gl.getExtension('WEBGL_lose_context')?.loseContext();
+    }
+    this.canvas?.removeEventListener('webglcontextlost', this.contextLost);
+    this.gl = null;
+    this.canvas = null;
+    this.program = null;
+    this.sourceUniform = null;
+    this.destinationUniform = null;
+    this.setUniforms = null;
+    this.vertexArray = null;
+    this.framebuffers = null;
+    this.destinations = null;
+    this.sources.length = 0;
+    this.zero = null;
+    this.staging = null;
+    this.schedulingGrid = null;
+  }
+}
diff --git a/tests/aokana-gpu-observation.test.mjs b/tests/aokana-gpu-observation.test.mjs
new file mode 100644
index 0000000..5194e9f
--- /dev/null
+++ b/tests/aokana-gpu-observation.test.mjs
@@ -0,0 +1,175 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {BurikoBitmapStorage} from '../dist/engines/buriko/native/bitmap.js';
+import {BurikoBitmapCompositor} from '../dist/engines/buriko/native/bitmap-compositor.js';
+import {
+  BurikoGpuBitmapBatch,
+  hasBurikoGpuBatch,
+  withBurikoGpuSuspended,
+} from '../dist/engines/buriko/native/bitmap-gpu.js';
+import {
+  clearBurikoBitmap,
+  copyBurikoBitmapRows,
+} from '../dist/engines/buriko/native/bitmap-copy.js';
+import {blendBurikoAlphaIntoRgb} from '../dist/engines/buriko/native/bitmap-alpha.js';
+import {blendTransformedBurikoBitmap} from '../dist/engines/buriko/native/bitmap-affine.js';
+import {recordRasterText, rasterTextBitmap, readRasterText} from '../dist/text/raster-text.js';
+
+function bitmap(width = 13, height = 8, format = 1, seed = 17) {
+  const bytes = Uint8Array.from({length: width * height * 4}, (_, i) => (i * 31 + seed) & 255);
+  return {
+    storage: new BurikoBitmapStorage(bytes, true),
+    offset: 0,
+    stride: width * 4,
+    width,
+    height,
+    format,
+    bytesPerPixel: 4,
+  };
+}
+
+test('deferred native and textless pixels remain current at observation and producer boundaries', () => {
+  function run(deferred) {
+    const destination = bitmap(),
+      source = bitmap(13, 8, 2, 97),
+      rgb = bitmap(13, 8, 1, 3);
+    recordRasterText(source, 'Synthetic', {width: 7, height: 5});
+    const retainedSource = source.storage.bytes,
+      retainedTarget = destination.storage.bytes;
+    const batch = new BurikoGpuBitmapBatch(Number.MAX_SAFE_INTEGER);
+    const observations = [];
+    const operation = () => {
+      clearBurikoBitmap(destination);
+      blendBurikoAlphaIntoRgb(destination, source);
+      observations.push(
+        destination.storage.cloneRange(0, destination.storage.byteLength).bytes.slice(),
+      );
+      copyBurikoBitmapRows(destination, rgb);
+      withBurikoGpuSuspended(() => {
+        // A producer can use pointers retained before this scope or call a native leaf itself.
+        observations.push(retainedTarget.slice());
+        clearBurikoBitmap(destination);
+        retainedTarget[3] = 117;
+        retainedSource[0] ^= 255;
+      });
+      // A producer can also replace audited methods; do not resume deferral this traversal.
+      assert.equal(hasBurikoGpuBatch(), false);
+      blendBurikoAlphaIntoRgb(destination, source);
+      // Separately constructed storage descriptors may alias the queued allocation.
+      const alias = new BurikoBitmapStorage(retainedTarget.subarray(4), true);
+      observations.push(alias.view.getUint32(0, true));
+      copyBurikoBitmapRows(destination, rgb);
+      source.storage.release();
+    };
+    try {
+      if (deferred) batch.run(destination, operation);
+      else operation();
+      return {
+        observations,
+        pixels: destination.storage.bytes.slice(),
+        textless: rasterTextBitmap(destination).storage.bytes.slice(),
+        glyphs: readRasterText(destination).map(({id, ...glyph}) => glyph),
+      };
+    } finally {
+      batch.dispose();
+    }
+  }
+  assert.deepEqual(run(true), run(false));
+});
+
+test('unavailable GPU replays pixel kernels without repeating metadata or native callbacks', () => {
+  function run(deferred) {
+    const destination = bitmap(),
+      source = bitmap(13, 8, 2),
+      compositor = new BurikoBitmapCompositor();
+    const batch = new BurikoGpuBitmapBatch(0, 1);
+    let calls = 0;
+    const operation = () => {
+      calls++;
+      clearBurikoBitmap(destination);
+      for (let i = 0; i < 9; i++)
+        blendTransformedBurikoBitmap(
+          compositor,
+          destination,
+          source,
+          {x: 16385, y: -21845, pivotX: 0, pivotY: 0, angle: 0, scaleX: 65536, scaleY: 65536},
+          i * 13,
+          i & 1,
+        );
+    };
+    try {
+      if (deferred) batch.run(destination, operation);
+      else operation();
+      return {calls, pixels: destination.storage.bytes.slice()};
+    } finally {
+      batch.dispose();
+    }
+  }
+  assert.equal(typeof globalThis.OffscreenCanvas, 'undefined');
+  assert.deepEqual(run(true), run(false));
+});
+
+test('a native fault materializes the accepted prefix and preserves partial stores', () => {
+  function run(deferred) {
+    const destination = bitmap(),
+      good = bitmap(13, 8, 1, 89),
+      bad = bitmap(13, 8);
+    bad.storage = new BurikoBitmapStorage(new Uint8Array(13 * 4 + 8), true);
+    const batch = new BurikoGpuBitmapBatch(Number.MAX_SAFE_INTEGER);
+    const operation = () => {
+      clearBurikoBitmap(destination);
+      copyBurikoBitmapRows(destination, good);
+      copyBurikoBitmapRows(destination, bad);
+    };
+    let message;
+    try {
+      assert.throws(
+        () => (deferred ? batch.run(destination, operation) : operation()),
+        (error) => {
+          message = error.message;
+          return /outside native allocation/.test(message);
+        },
+      );
+      return {message, pixels: destination.storage.bytes.slice()};
+    } finally {
+      batch.dispose();
+    }
+  }
+  assert.deepEqual(run(true), run(false));
+});
+
+test('custom storage callbacks observe completed pixels without extra admission calls', () => {
+  function run(deferred, observeAlias) {
+    const destination = bitmap(),
+      source = bitmap(13, 8, 1, 89),
+      retained = destination.storage.bytes,
+      observations = [];
+    const custom = observeAlias ? new BurikoBitmapStorage(retained, true) : source.storage;
+    const nativeView = custom.batchingView;
+    custom.batchingView = function (offset, length) {
+      observations.push(retained[0]);
+      return nativeView.call(this, offset, length);
+    };
+    const batch = new BurikoGpuBitmapBatch(Number.MAX_SAFE_INTEGER);
+    const operation = () => {
+      clearBurikoBitmap(destination);
+      if (observeAlias) observations.push(custom.bytes[0]);
+      else copyBurikoBitmapRows(destination, source);
+      // Unknown storage callbacks can mutate previously audited collaborators.
+      assert.equal(hasBurikoGpuBatch(), false);
+      copyBurikoBitmapRows(destination, bitmap(13, 8, 1, 47));
+    };
+    try {
+      if (deferred) batch.run(destination, operation);
+      else operation();
+      return {observations, pixels: destination.storage.bytes.slice()};
+    } finally {
+      batch.dispose();
+    }
+  }
+  for (const observeAlias of [false, true]) {
+    const expected = run(false, observeAlias);
+    assert.deepEqual(expected.observations, [0]);
+    assert.deepEqual(run(true, observeAlias), expected);
+  }
+});
